{
  "name": "Auto Scroller",
  "version": "0.1",
  "manifest_version": 3,
  "description": "A browser extension that auto-scrolls webpages",
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-scripts/webpage-mode.js"]
    }
  ]
}
